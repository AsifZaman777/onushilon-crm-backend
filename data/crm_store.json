    {
      "section_id": "story",
      "name": "Our Story Section",
      "data_en": {
        "heading": "Onushilon means practice. We took it literally.",
        "lead": "We started because lectures alone never made anyone truly confident. Every course here is built around doing the work, getting detailed mentor feedback, and mastering the concept.",
        "timeline": [
          {
            "basis": "yearly",
            "year": "2014",
            "year_en": "2014",
            "year_bn": "২০১৪",
            "text": "Five students, one rented room, and a rule: every lesson ends with practice.",
            "text_en": "Five students, one rented room, and a rule: every lesson ends with practice.",
            "text_bn": "পাঁচজন শিক্ষার্থী, একটি ভাড়া করা কক্ষ এবং একটিই মূলমন্ত্র: প্রতিটি ক্লাসের শেষেই নিয়মিত অনুশীলন।"
          },
          {
            "basis": "yearly",
            "year": "2018",
            "year_en": "2018",
            "year_bn": "২০১৮",
            "text": "We opened a second branch and began recording every class for revision.",
            "text_en": "We opened a second branch and began recording every class for revision.",
            "text_bn": "দ্বিতীয় শাখার যাত্রা এবং ক্লাসের পর রিভিশন নিশ্চিত করতে প্রতিটি সেশনের রেকর্ডিং শুরু।"
          },
          {
            "basis": "yearly",
            "year": "2022",
            "year_en": "2022",
            "year_bn": "২০২২",
            "text": "Onushilon went online. Students from 40 districts joined live.",
            "text_en": "Onushilon went online. Students from 40 districts joined live.",
            "text_bn": "অনুশীলন অনলাইন প্ল্যাটফর্মে রূপান্তরিত হয়। দেশের ৪০টিরও বেশি জেলা থেকে শিক্ষার্থীরা অংশ নেয়।"
          },
          {
            "basis": "monthly",
            "year": "Nov 2023",
            "year_en": "Nov 2023",
            "year_bn": "নভেম্বর ২০২৩",
            "text": "Launched the STEM Robotics Lab & Hardware diagnostics center.",
            "text_en": "Launched the STEM Robotics Lab & Hardware diagnostics center.",
            "text_bn": "স্টেম রোবোটিক্স ল্যাব ও হার্ডওয়্যার ডায়াগনস্টিকস সেন্টারের আনুষ্ঠানিক উদ্বোধন।"
          },
          {
            "basis": "yearly",
            "year": "Today",
            "year_en": "Today",
            "year_bn": "বর্তমান",
            "text": "Over 12,000 learners practise with us every week.",
            "text_en": "Over 12,000 learners practise with us every week.",
            "text_bn": "প্রতি সপ্তাহে ১২,০০০-এর বেশি শিক্ষার্থী আমাদের সাথে নিয়মিত চর্চায় অংশ নিচ্ছে।"
          }
        ]
      },
