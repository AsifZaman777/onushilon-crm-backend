# ==============================================================================
# Development Server Configuration (Local)
# ==============================================================================
PORT=5000
NODE_ENV=development

# Allowed CORS Origins (comma separated)
CLIENT_ORIGIN=http://localhost:3000,http://localhost:5000,https://onushilon-crm-backend.onrender.com

# Public website to refresh after CRM edits (must expose /api/revalidate)
WEBSITE_URL=http://localhost:3000
# Shared secret, must match REVALIDATE_SECRET in the website environment
REVALIDATE_SECRET=change-me

# Supabase Configuration
# Replace these with your project URL and Service Role Key from https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_NAME=onushilon

# Admin Authentication
JWT_SECRET=onushilon_super_secret_jwt_key_2026_crm
ADMIN_EMAIL=admin@onushilon.com
ADMIN_PASSWORD=admin1234

# ==============================================================================
# Production Server (Render Environment Variables):
#   PORT=10000 (set automatically by Render)
#   NODE_ENV=production
#   CLIENT_ORIGIN=https://<your-website-domain>,https://onushilon-crm-backend.onrender.com
#   WEBSITE_URL=https://<your-website-domain>
# ==============================================================================
